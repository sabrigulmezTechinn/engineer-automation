# Bu dosyayı .env.local olarak kopyalayın ve değerleri doldurun:
#   cp .env.example .env.local
# .env.local git'e eklenmez. Next.js, drizzle-kit ve entegrasyon testleri .env.local'ı okur.

# PostgreSQL bağlantı adresi. scripts/db-setup.sh varsayılan olarak bu kullanıcıyı ve veritabanını oluşturur.
DATABASE_URL=postgres://engineer:engineer@localhost:5432/engineer_automation

# Oturum çerezlerini ve doğrulama bağlantılarını imzalamak için gizli anahtar (en az 32 karakter, rastgele).
# Üretmek için: openssl rand -base64 32
# Üretim derlemesinde (next build) tanımlı olmazsa better-auth hata verir.
BETTER_AUTH_SECRET=

# Uygulamanın tarayıcıdan erişilen kök adresi. E-postadaki doğrulama ve şifre sıfırlama bağlantıları
# bu adresle oluşturulur; geliştirme sunucusunun portuyla aynı olmalıdır.
BETTER_AUTH_URL=http://localhost:3000

# (İsteğe bağlı) Geliştirme e-postalarının yazılacağı klasör. Varsayılan: proje kökündeki .dev-mail/
# DEV_MAIL_DIR=.dev-mail
